generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  FREELANCE
  PART_TIME
  APPRENTICESHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum EducationLevel {
  NONE
  BAC
  BAC_PLUS_2
  LICENCE
  MASTER
  ENGINEER
  DOCTORATE
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum ProfileVisibility {
  HIDDEN
  APPLICANTS_ONLY
  SEARCHABLE
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

enum HiringStatus {
  ACTIVELY_HIRING
  OPEN_TO_APPLICATIONS
  NOT_HIRING
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  passwordHash             String
  name                     String
  role                     Role                      @default(CANDIDATE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  candidateProfile         CandidateProfile?
  employerProfile          EmployerProfile?
  applicationStatusChanges ApplicationStatusEvent[]
}

model Place {
  id          String             @id @default(cuid())
  name        String
  governorate String
  latitude    Float
  longitude   Float
  companies   Company[]
  jobs        Job[]
  candidates  CandidateProfile[]

  @@unique([governorate, name])
}

model Profession {
  id         String             @id @default(cuid())
  slug       String             @unique
  nameFr     String
  category   String
  jobs       Job[]
  candidates CandidateProfile[]
}

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  slug       String?          @unique
  aliases    String[]         @default([])
  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  location          String?
  headline          String?
  bio               String?           @db.Text
  professionId      String?
  profession        Profession?       @relation(fields: [professionId], references: [id])
  placeId           String?
  place             Place?            @relation(fields: [placeId], references: [id])
  yearsExperience   Int?
  educationLevel    EducationLevel?
  profileVisibility ProfileVisibility @default(APPLICANTS_ONLY)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cvs               CV[]
  skills            CandidateSkill[]
  experiences       Experience[]
  applications      Application[]
  matches           AIMatch[]

  @@index([profileVisibility, professionId, placeId])
}

model CV {
  id           String           @id @default(cuid())
  candidateId  String
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  parsedText   String?          @db.Text
  isActive     Boolean          @default(true)
  uploadedAt   DateTime         @default(now())
  applications Application[]

  @@index([candidateId])
}

model CandidateSkill {
  candidateId String
  skillId     String
  level       Int?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
}

model Experience {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  companyName String
  startDate   DateTime
  endDate     DateTime?
  description String?          @db.Text

  @@index([candidateId])
}

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  jobTitle  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String?         @unique
  patenteNumber         String?         @unique
  employeeCount         Int?
  description           String?         @db.Text
  industry              String?
  size                  CompanySize?
  website               String?
  contactEmail          String?
  phone                 String?
  address               String?
  location              String?
  placeId               String?
  place                 Place?          @relation(fields: [placeId], references: [id])
  logoKey               String?
  hiringStatus          HiringStatus    @default(NOT_HIRING)
  hiringNote            String?
  hiringStatusUpdatedAt DateTime        @default(now())
  employers             EmployerProfile[]
  jobs                  Job[]
  posts                 CompanyPost[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Job {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  description        String          @db.Text
  professionId       String?
  profession         Profession?     @relation(fields: [professionId], references: [id])
  experienceMinYears Int?
  educationLevel     EducationLevel?
  contractType       ContractType    @default(CDI)
  workMode           WorkMode        @default(ONSITE)
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String          @default("TND")
  placeId            String?
  place              Place?          @relation(fields: [placeId], references: [id])
  status             JobStatus       @default(DRAFT)
  publishedAt        DateTime?
  deadline           DateTime?
  skills             JobSkill[]
  languages          JobLanguage[]
  applications       Application[]
  matches            AIMatch[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([companyId, status])
  @@index([status, publishedAt])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}

model JobLanguage {
  jobId        String
  languageCode String
  minLevel     LanguageLevel
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, languageCode])
}

model Application {
  id              String                   @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId            String?
  cv              CV?                      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  coverLetter     String?                  @db.Text
  status          ApplicationStatus         @default(PENDING)
  internalNote    String?
  statusUpdatedAt DateTime                 @default(now())
  events          ApplicationStatusEvent[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([candidateId, jobId])
  @@index([jobId, status])
}

model ApplicationStatusEvent {
  id                 String            @id @default(cuid())
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus         ApplicationStatus
  toStatus           ApplicationStatus
  changedById        String
  changedBy          User              @relation(fields: [changedById], references: [id])
  messageToCandidate String?
  interviewAt        DateTime?
  createdAt          DateTime          @default(now())

  @@index([applicationId, createdAt])
}

model AIMatch {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score       Float
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobId])
}
enum PostType {
  PROJECT
  NEWS
}

model CompanyPost {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        PostType @default(PROJECT)
  title       String
  content     String   @db.Text
  imageKeys   String[]
  videoUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, createdAt])
}