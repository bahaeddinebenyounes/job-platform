// ───────── Entreprise ─────────
enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

enum HiringStatus {
  ACTIVELY_HIRING
  OPEN_TO_APPLICATIONS
  NOT_HIRING
}

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  jobTitle  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Company {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  patenteNumber String?      @unique
  employeeCount Int?
  description   String?
  industry      String?
  size          CompanySize?
  website       String?
  contactEmail  String?
  phone         String?
  address       String?
  placeId       String?
  place         Place?       @relation(fields: [placeId], references: [id])
  logoKey       String?

  hiringStatus          HiringStatus @default(NOT_HIRING)
  hiringNote            String?
  hiringStatusUpdatedAt DateTime     @default(now())

  employers EmployerProfile[]
  jobs      Job[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// ───────── Offres d'emploi ─────────
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  FREELANCE
  PART_TIME
  APPRENTICESHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum EducationLevel {
  NONE
  BAC
  BAC_PLUS_2
  LICENCE
  MASTER
  ENGINEER
  DOCTORATE
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

model Job {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  description        String
  professionId       String?
  profession         Profession?     @relation(fields: [professionId], references: [id])
  experienceMinYears Int?
  educationLevel     EducationLevel?
  contractType       ContractType
  workMode           WorkMode        @default(ONSITE)
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String          @default("TND")
  placeId            String?
  place              Place?          @relation(fields: [placeId], references: [id])
  status             JobStatus       @default(DRAFT)
  publishedAt        DateTime?
  deadline           DateTime?
  skills             JobSkill[]
  languages          JobLanguage[]
  applications       Application[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([companyId, status])
  @@index([status, publishedAt])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}

model JobLanguage {
  jobId        String
  languageCode String
  minLevel     LanguageLevel
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobId, languageCode])
}

